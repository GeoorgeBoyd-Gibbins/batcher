# Tracking API (legacy /tracking endpoint — the one that is deployed).
# When both are set, every dispatch is recorded here. Leave BATCHER_BYPASS_AUTH=true
# alongside them so the GUI does not ask for a Phase 0 sign-in.
BATCHER_BYPASS_AUTH=true
TRACKING_API_URL=https://id5data2.onrender.com/tracking
TRACKING_API_KEY=your-api-key

# SMTP (Stackmail)
SMTP_HOST=smtp.stackmail.com
SMTP_PORT=587
SMTP_USER=your-email@id5certified.co.uk
SMTP_PASSWORD=your-password
SENDER_EMAIL=your-email@id5certified.co.uk
# Optional: where customer replies should go if different from SENDER_EMAIL
# REPLY_TO=george@id5.co.uk
# Extra BCC on every dispatch email (comma-separated). Sender is always BCC'd.
DISPATCH_BCC=contact@id5.co.uk
# Trustpilot Automatic Feedback Service BCC address — triggers a verified review
# invite to the customer. Leave empty to disable. Never sent in TEST_EMAIL_OVERRIDE mode.
TRUSTPILOT_BCC=id5.co.uk+5c585510e3@invite.trustpilot.com
# How the dispatch email asks for a review (also switchable from the GUI Email menu):
#   bcc  = BCC the invite address above and tell the customer to expect a Trustpilot invite
#   link = no BCC; the email carries a "Trustpilot Review" hyperlink to TRUSTPILOT_REVIEW_URL
#   off  = no BCC and no review request paragraph
TRUSTPILOT_MODE=bcc
TRUSTPILOT_REVIEW_URL=https://www.trustpilot.com/evaluate/id5.co.uk

# Testing — set this to redirect ALL emails to a test address
# TEST_EMAIL_OVERRIDE=george1uk@hotmail.com

# Paths
DROPBOX_BASE=~/Library/CloudStorage/Dropbox/ID5 matters
BATCHES_DIR=./batches
